# Логи заявок содержат персональные данные — наружу их отдавать нельзя.
# Apache 2.4
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>

# На nginx .htaccess не работает — закройте каталог в конфиге сайта:
#   location ^~ /api/logs/ { deny all; return 404; }
